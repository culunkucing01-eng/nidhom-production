# Base URL API backend untuk aplikasi web.
#
# Development (default): biarkan KOSONG agar request memakai path relatif
#   (/api, /auth) yang di-proxy oleh Vite dev server ke http://127.0.0.1:8787
#   (lihat vite.config.ts). Jalankan backend dengan:  cd apps/api && npm run dev
#
# Produksi / saat frontend dilayani TANPA proxy: isi URL absolut API, mis.
#   VITE_API_BASE_URL=https://<domain-api>
#   CATATAN: koneksi lintas-origin langsung hanya bekerja bila backend
#   mengizinkan CORS serta Origin frontend (FRONTEND_ORIGINS). Untuk dev lokal,
#   cukup gunakan proxy (biarkan kosong).
VITE_API_BASE_URL=
