{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://nidhom-api.culunkucing01.workers.dev/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://nidhom-api.culunkucing01.workers.dev/api/:path*"
    },
    {
      "source": "/((?!auth/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
