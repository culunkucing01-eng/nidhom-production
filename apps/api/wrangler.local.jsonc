{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nidhom-api-local",
  "main": "src/local.ts",
  "compatibility_date": "2026-11-04",

  "build": {
    "command": "node scripts/validate-local-command.mjs"
  },

  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nidhom-api-local",
      "migrations_dir": "migrations"
    }
  ]
}
