{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nidhom-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",

  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true,

  "vars": {
    "FRONTEND_ORIGINS": "https://sistemgurumanajemen.vercel.app"
  },

  "build": {
    "command": "node scripts/validate-production-config.mjs --wrangler-hook"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nidhom-production",
      "database_id": "a9540faf-320b-48df-a849-3c5ca0235ef0",
      "migrations_dir": "migrations"
    }
  ],

  // Pembatasan percobaan login memakai KV Namespace (counter + TTL 60s) di auth.ts.
  "kv_namespaces": [
    { "binding": "LOGIN_IP_RATE_LIMITER", "id": "6d9c2f782dbc4bc3b211c2ccd432cc44" },
    { "binding": "LOGIN_USERNAME_RATE_LIMITER", "id": "91159c2e5da5460187124f1c70772c59" }
  ]
}